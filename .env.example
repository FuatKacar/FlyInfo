# FlyInfo — ortam ayarları
# Bu dosyayı ".env" adıyla kopyalayın. Hiçbir anahtar zorunlu değildir:
# LLM tanımlı değilse yanıtlar şablon metinle üretilir.

# LLM sağlayıcısı: none | gemini | groq | ollama
SINEK_LLM_PROVIDER=none

# Google Gemini (https://aistudio.google.com/ adresinden ücretsiz alınabilir)
SINEK_GEMINI_API_KEY=
SINEK_GEMINI_MODEL=gemini-3.8-flash
SINEK_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq (yedek sağlayıcı)
SINEK_GROQ_API_KEY=
SINEK_GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (çevrimdışı, opsiyonel)
SINEK_OLLAMA_URL=http://localhost:11434
SINEK_OLLAMA_MODEL=qwen3

# Sunucu
SINEK_HOST=127.0.0.1
SINEK_PORT=8000

# Veri dizinleri
SINEK_DATA_DIR=data
SINEK_ARTIFACTS_DIR=artifacts
SINEK_CACHE_DIR=cache
